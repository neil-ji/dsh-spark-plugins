{
  "name": "dsh-spark-plugins",
  "private": true,
  "type": "module",
  "description": "本地自用 monorepo：dsh 第三方插件与组件（ui-kit / plugin-kit / hippomemo / finance / connector）",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && vitest run",
    "dev": "node scripts/dev.mjs",
    "install:profile": "node scripts/install-profile.mjs",
    "escape": "node scripts/escape-profile.mjs --boot",
    "escape:init": "node scripts/escape-profile.mjs",
    "check:dsh-upgrade": "node scripts/check-dsh-upgrade.mjs --write-report",
    "dryrun:dsh-upgrade": "node scripts/dryrun-upgrade.mjs",
    "finance:sync-prices": "node scripts/sync-finance-prices.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "esbuild": "^0.25.0"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=20"
  }
}
