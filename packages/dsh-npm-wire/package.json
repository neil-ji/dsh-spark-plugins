{
  "name": "dsh-connector-npm-wire",
  "version": "0.2.0",
  "description": "DSH npm 管线 wire：remote 协议与类型定义",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.1-rc.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "^0.1.1-rc.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "zod": "^4.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neil-ji/dsh-spark-plugins.git",
    "directory": "packages/dsh-npm-wire"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin"
  ],
  "bugs": {
    "url": "https://github.com/neil-ji/dsh-spark-plugins/issues"
  },
  "homepage": "https://neil-ji.github.io/dsh-spark-plugins/"
}
