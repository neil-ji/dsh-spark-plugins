{
  "name": "dsh-spark-plugin-kit",
  "version": "0.5.0",
  "description": "DSH 第三方插件公共层：事件订阅运行时（$stream 扇出 / 引用计数 / 基线重同步）· 插件 CSS 注入 · Snapshot 绑定",
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-rc.1",
    "react": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neil-ji/dsh-spark-plugins.git",
    "directory": "packages/dsh-plugin-kit"
  },
  "bugs": {
    "url": "https://github.com/neil-ji/dsh-spark-plugins/issues"
  },
  "homepage": "https://neil-ji.github.io/dsh-spark-plugins/",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib"
  ]
}
