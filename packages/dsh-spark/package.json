{
  "name": "dsh-spark",
  "version": "0.1.0",
  "description": "DSH 火花认知层 host：spark 流（情景记忆）+ JSONL 持久化 + HTTP API + agent 工具",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec test/spark-core.test.ts test/proposals.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dsh-spark-wire": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^0.1.1-rc.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "zod": "^4.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neil-ji/dsh-spark-plugins.git",
    "directory": "packages/dsh-spark"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "spark",
    "cognitive-layer"
  ],
  "bugs": {
    "url": "https://github.com/neil-ji/dsh-spark-plugins/issues"
  },
  "homepage": "https://neil-ji.github.io/dsh-spark-plugins/"
}
