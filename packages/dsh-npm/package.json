{
  "name": "dsh-connector-npm",
  "version": "0.1.0",
  "description": "Third-party DeepSeek Harness bundle: one-shot npm package launch (scaffold -> GitHub repo + CICD -> OIDC npm release + Pages)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "templates"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dsh-connector-npm-wire": "workspace:^",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-registry": "^0.1.0-rc.6",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "dsh-connector-github": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neil-ji/dsh-connector-kit.git"
  },
  "private": true
}