{
  "name": "dsh-connector-npm",
  "version": "0.2.0",
  "description": "DSH npm 发布管线 host：包名/trust 检查、OIDC 发布流程、Pages 站点上线",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "templates"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dsh-connector-npm-ui": "workspace:*",
    "dsh-connector-npm-wire": "workspace:*",
    "zod": "^4.0.0",
    "@deepseek-ai/dsh-credentials": ">=0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "^0.1.1-rc.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "dsh-connector-github": "workspace:^",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neil-ji/dsh-spark-plugins.git",
    "directory": "packages/dsh-npm"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin"
  ],
  "bugs": {
    "url": "https://github.com/neil-ji/dsh-spark-plugins/issues"
  },
  "homepage": "https://neil-ji.github.io/dsh-spark-plugins/"
}
