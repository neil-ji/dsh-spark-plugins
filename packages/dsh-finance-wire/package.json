{
  "name": "dsh-spark-finance-wire",
  "version": "0.1.0",
  "description": "DSH 成本统计插件 wire：host/client 共享的 remote 协议、Zod 边界 schema 与反射模型",
  "type": "module",
  "homepage": "https://neil-ji.github.io/dsh-spark-plugins/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neil-ji/dsh-spark-plugins.git",
    "directory": "packages/dsh-finance-wire"
  },
  "bugs": {
    "url": "https://github.com/neil-ji/dsh-spark-plugins/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "^0.1.2-rc.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "^0.1.2-rc.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "zod": "^4.0.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin"
  ]
}
