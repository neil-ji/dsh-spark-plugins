{
  "name": "dsh-ui-kit",
  "version": "0.2.0",
  "description": "复刻 DSH 设计系统的本地 React 组件库（零 cordis）：按钮/输入/Pill/图表/Markdown 渲染全套",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "react",
    "ui",
    "design-system",
    "tokens",
    "plugin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": {
      "types": "./dist/styles/tokens.css.d.ts",
      "default": "./dist/styles/tokens.css"
    },
    "./katex.css": {
      "types": "./dist/katex/katex.min.css.d.ts",
      "default": "./dist/katex/katex.min.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "homepage": "https://neilji.github.io/dsh-spark-plugins/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neil-ji/dsh-spark-plugins.git",
    "directory": "packages/dsh-ui-kit"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "typecheck": "tsc --noEmit",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "build:site": "node scripts/build-site.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "prepack": "npm run build",
    "test": "node --test test/smoke.test.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@shikijs/langs": "^4.3.1",
    "@types/mdast": "^4.0.4",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "lightningcss": "^1.29.0",
    "marked": "^15.0.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "bugs": {
    "url": "https://github.com/neil-ji/dsh-spark-plugins/issues"
  }
}
