{
  "name": "dsh-spark-finance",
  "version": "0.2.0",
  "description": "DSH 成本统计插件 host：余额接入、账本重放、峰谷/供应商/模型/工作区成本计算核心",
  "type": "module",
  "homepage": "https://neil-ji.github.io/dsh-spark-plugins/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neil-ji/dsh-spark-plugins.git",
    "directory": "packages/dsh-finance"
  },
  "bugs": {
    "url": "https://github.com/neil-ji/dsh-spark-plugins/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/types/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/types/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": ">=0.1.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.2",
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node build.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  }
}
