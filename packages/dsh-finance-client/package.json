{
  "name": "dsh-spark-finance-client",
  "version": "0.4.7",
  "description": "DSH 成本统计插件 client：四个决策视图（本月值不值 / 该用谁 / 怎么调度更省 / 项目账），UI 对齐 DSH 设计系统",
  "type": "module",
  "homepage": "https://neil-ji.github.io/dsh-spark-plugins/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neil-ji/dsh-spark-plugins.git",
    "directory": "packages/dsh-finance-client"
  },
  "bugs": {
    "url": "https://github.com/neil-ji/dsh-spark-plugins/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1",
    "dsh-spark-finance": "^0.1.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1",
    "@types/react": "~18.3.1",
    "dsh-spark-finance": "workspace:^",
    "esbuild": "^0.25.0",
    "react": "^18.2.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node build.mjs"
  },
  "dependencies": {
    "dsh-spark-finance": "workspace:*",
    "dsh-spark-finance-wire": "workspace:*",
    "dsh-spark-plugin-kit": "workspace:*",
    "dsh-ui-kit": "workspace:*"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  }
}
