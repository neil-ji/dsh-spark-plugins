{
  "name": "dsh-spark-dock",
  "version": "0.2.0",
  "description": "DSH Spark Dock：宿主 web 的全局悬浮球 + 插件统一面板（shell.overlay 入口）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "dsh-connector-github-ui": "workspace:*",
    "dsh-connector-npm-ui": "workspace:*",
    "dsh-hippomemo": "workspace:*",
    "dsh-spark-finance-client": "workspace:*",
    "dsh-spark-plugin-kit": "workspace:*",
    "dsh-spark-wire": "workspace:*",
    "dsh-ui-kit": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "lightningcss": "^1.22.0",
    "react": "^18.2.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neil-ji/dsh-spark-plugins.git",
    "directory": "packages/dsh-spark-dock"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "spark",
    "dock",
    "floating-ball"
  ]
}
